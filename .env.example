# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=https://avid-gnat-604.convex.cloud

# Convex site URL used by Convex Auth (not your Hostinger website URL)
CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Public origin of the frontend; Convex Auth uses this for auth redirects.
SITE_URL=https://<your-hostinger-domain>

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:avid-gnat-604 # team: prince-e7ac2, project: direct-estate-direct


# Email OTP is sent by the Convex backend using Resend.
# Configure RESEND_API_KEY on the Convex deployment; do not use a VITE_ prefix.
